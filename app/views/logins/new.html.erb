<% content_for :hide_search, true %>
<h1 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-900">ログイン</h1>

<div class="form-container">
  <%= form_with(url: login_path) do |form| %>
    <div class="form-group">
      <%= form.label :student_id, '学籍番号' %>
      <%= form.text_field :student_id, value: params[:student_id] %>
    </div>

    <div class="form-group">
      <%= form.label :password, 'パスワード' %>
      <%= form.password_field :password, value: params[:password] %>
    </div>

    <div>
      <%= form.submit 'ログイン' %>
    </div>
  <% end %>
</div>