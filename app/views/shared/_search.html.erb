<div class="search-container">
  <%= form_with url: kigos_path, method: :get, local: true, class: 'search-form' do |f| %>
    <%= f.text_field :search, placeholder: "単語を検索", value: params[:search], type: 'search' %>
    <%= f.select :search_type,
          options_for_select([['見出し語', 'headword'], ['季節', 'season']], @search_type) %>
    <%= f.submit "検索" %>
  <% end %>
</div>