<aside class="right_sidebar">
  <div class="right_sidebar-inner">
    <div class="right_sidebar-auth-links">
      <%# ログインしている場合 %>
      <% if defined?(current_user) && current_user.present? %>
        <span class="user-welcome">ようこそ、<%= current_user.name %> さん</span>
        <%= link_to "ログアウト", logout_path, data: { turbo_method: :delete }, class: "btn btn-logout" %>
      <%# ログインしていない場合 %>
      <% else %>
        <%= link_to "ログイン", class: "btn btn-login" %>
      <% end %>
    </div>
  </div>
</aside>