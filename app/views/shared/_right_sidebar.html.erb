<aside class="right_sidebar">
  <div class="right_sidebar-inner">
    <div class="right_sidebar-auth-links">
      <%# ログインしている場合 %>
      <% if current_user.present? %>
        <span class="user-welcome">ようこそ、<%= current_user.name %> さん</span>
        <%= link_to "ログアウト", login_path, data: { turbo_method: :delete }, class: "btn btn-logout" %>
      <%# ログインしていない場合 %>
      <% else %>
        <%= link_to "ログイン", new_login_path, class: "btn btn-login" %>
      <% end %>
    </div>
    <div class="right_sidebar-auth-links">
      <%# ログインしている場合 %>
      <% if current_user.present? %>
        <%= link_to "ユーザー情報", user_path(current_user), class: "btn btn-user" %>
      <%# ログインしていない場合 %>
      <% else %>
         <%= link_to "ユーザー登録", new_user_path, class: "btn btn-user" %>
      <% end %>
    </div>
    <div class="right_sidebar-auth-links">
      <%= link_to "季語の登録", new_kigo_path, class: "btn btn-kigo" %>
    </div>
  </div>
</aside>