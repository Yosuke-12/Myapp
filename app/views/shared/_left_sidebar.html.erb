<aside class="left_sidebar">
  <div class="left_sidebar-inner">
    <div class='left_sidebar-logo'>
      <%= link_to root_path do %>
        <%= image_tag 'logo.png', alt: 'Your歳時記', class: '-mt-3 h-18 w-auto hover:opacity-80 transition-opacity' %>
      <% end %>
    </div>

    <ul class="left_sidebar-list">
      <% if @words.present? %>
        <% @words.each do |word| %>
          <li class="left_sidebar-item">
            <%= link_to word.headword, kigo_path(word), class: "left_sidebar-link", data: { turbo_frame: "word_detail" } %>
          </li>
        <% end %>
      <% else %>
        <li class="left_sidebar-empty">検索結果がありません</li>
      <% end %>
    </ul>
  </div>
</aside>