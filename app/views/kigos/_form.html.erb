<%= form_with(model: kigo) do |form| %>
  <div class="form-container">
    <% if kigo.errors.any? %>
      <div class="mb-6 rounded-md bg-red-50 p-4 border border-red-200">
        <h2><%= kigo.errors.count %>件のエラーが発生しました:
        </h2>
        <ul class="mt-2 list-disc list-inside text-sm text-red-700 space-y-1">
          <% kigo.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= form.label :headword do %>
        見出し語<span class="text-red-600">*</span>
      <% end %>
      <%= form.text_field :headword %>
    </div>

    <div class="form-group">
      <%= form.label :season do %>
        季節<span class="text-red-600">*</span>
      <% end %>
      <%= form.text_field :season %>
    </div>

    <div class="form-group">
      <%= form.label :meaning do %>
        意味<span class="text-red-600">*</span>
      <% end %>
      <%= form.text_field :meaning %>
    </div>

    <div class="form-group">
      <%= form.label :example do %>
        作例<span class="text-red-600">*</span>
      <% end %>
      <%= form.text_field :example %>
    </div>

    <%= form.submit '登録' %>
  </div>

  <div class="mt-6 text-center text-red-600">
    <p>アスタリスク（*）は必須項目</p>
  </div>
<% end %>