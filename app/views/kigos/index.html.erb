<% content_for(:title, 'Your歳時記') %>
<%= turbo_frame_tag "word_detail" do %>
  <div class="word-detail">
    <% if @word %>
      <h1><%= @word.headword %></h1>
      <div class="definition">
        <p><b>季節</b>：<%= @word.season %></p>
        <p><b>意味</b>：<%= @word.meaning %></p>
        <p><b>作例</b>：<%= @word.example %></p>
        <p class="word-author">作成者：<%= @word.user.name %></p>
      </div>
    <% else %>
      <%= image_tag 'top.png' %>
    <% end %>
  </div>
<% end %>